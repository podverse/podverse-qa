#####
##### General
#####

NODE_ENV=development
USER_AGENT=Podverse/2/Alpha/Worker

#####
##### Logs
#####

LOG_LEVEL=info
LOG_DIR=
LOG_TIMER=true

#####
##### Postgres
#####

DB_HOST=localhost
DB_PORT=5432
DB_READ_USERNAME=read
DB_READ_PASSWORD=your_read_password
DB_READ_WRITE_USERNAME=user
DB_READ_WRITE_PASSWORD=mysecretpw
DB_DATABASE=postgres
DB_SSL_CONNECTION=

#####
##### Podcast Index
#####

PODCAST_INDEX_BASE_URL=https://api.podcastindex.org/api/1.0
PODCAST_INDEX_AUTH_KEY=
PODCAST_INDEX_SECRET_KEY=

#####
##### Google / FCM
#####
### We use FCM to send push notifications.

# Set as absolute path
FIREBASE_PATH_TO_AUTH_JSON=
FIREBASE_PROJECT_ID=
